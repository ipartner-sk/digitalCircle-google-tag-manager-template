___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const log = require('logToConsole');

const tagId = data.clientHashtag || 'DEV-0000';
const url = 'https://digitalcircle.ipartner.company/' + tagId;

// Securely inject script via GTM API
injectScript(url, function() {
  data.gtmOnSuccess();
}, function() {
  log('Failed to load DigitalCircle script: ' + url);
  data.gtmOnFailure();
});


